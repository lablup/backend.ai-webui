# Env file for the admin part of the e2e suite (E2E_PART=admin), which runs
# the admin console specs under e2e/admin/ against its own server.
# Copy to e2e/envs/.env.playwright.admin; playwright.config.ts requires it for
# any part list that includes admin (E2E_ENV_FILE overrides) and fails without
# it. Same variable names as e2e/envs/.env.playwright.
SCREENSHOT_PATH=./screenshots

# E2E Test Configuration
# Endpoints
E2E_WEBUI_ENDPOINT=http://127.0.0.1:9081
E2E_WEBSERVER_ENDPOINT=http://127.0.0.1:8090

# User Credentials
# Admin user
E2E_ADMIN_EMAIL=admin@lablup.com
E2E_ADMIN_PASSWORD=change-me

# Regular user
E2E_USER_EMAIL=user@lablup.com
E2E_USER_PASSWORD=change-me

# Second regular user
E2E_USER2_EMAIL=user2@lablup.com
E2E_USER2_PASSWORD=change-me

# Monitor user
E2E_MONITOR_EMAIL=monitor@lablup.com
E2E_MONITOR_PASSWORD=change-me

# Domain admin user
E2E_DOMAIN_ADMIN_EMAIL=domain-admin@lablup.com
E2E_DOMAIN_ADMIN_PASSWORD=change-me

# Default container image for session creation tests
E2E_DEFAULT_IMAGE=cr.backend.ai/multiarch/python:3.9-ubuntu20.04
