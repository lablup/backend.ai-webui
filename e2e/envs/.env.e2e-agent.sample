# Model behind agent.* steps in the e2e-agent suite (any OpenAI-compatible endpoint).
E2E_LLM_API_KEY=YOUR_LLM_API_KEY
E2E_LLM_BASE_URL=YOUR_LLM_BASE_URL
E2E_LLM_MODEL=YOUR_LLM_MODEL

# WebUI under test; falls back to E2E_WEBUI_ENDPOINT in the env file the run reads
# (.env.playwright, or .env.playwright.admin for E2E_PART=admin). Leave it unset when you run
# parts against different servers. Endpoints and accounts belong in those env files: with
# E2E_PART=admin or E2E_ENV_FILE, e2e.config.ts refuses them here.
# E2E_AGENT_APP_URL=https://backend-ai-webui.localhost:1355

# Chromium without the Local Network Access check, for an https app whose backend is on a
# private IP; automatic for that case, 1 forces it on, 0 off. E2E_AGENT_CHROMIUM overrides the binary.
# E2E_AGENT_DISABLE_LNA=1
# E2E_AGENT_CHROMIUM=/path/to/chromium

# 1 fails sign-in on "Logged in elsewhere" instead of ending the other session.
# E2E_AGENT_NO_FORCE_LOGIN=1
