{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/recursiveSchema",
  "definitions": {
    "rawValueLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "recursiveSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^[0-9A-Z].*$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/rawValueLabels"
            }
          ]
        },
        "^[a-z].*$": {
          "$ref": "#/definitions/recursiveSchema"
        }
      }
    }
  }
}
