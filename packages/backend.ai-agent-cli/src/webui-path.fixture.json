    "expected": "/session?sessionDetail=sess-1",
    "access": "user"
  },
  {
    "name": "session detail",
    "ref": {
      "type": "session",
      "id": "sess-1",
      "view": "detail"
    },
    "expected": "/session?sessionDetail=sess-1",
    "access": "user"
  },
  {
